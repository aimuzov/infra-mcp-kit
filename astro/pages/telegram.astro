---
import { localeOfPath } from '@aimuzov/infra-site-kit/i18n.js'
import config from 'virtual:infra-mcp-kit/pages'

import TelegramLogin from '@aimuzov/infra-mcp-kit/astro/components/telegram-login.svelte'
import Layout from '@aimuzov/infra-mcp-kit/astro/layout.astro'
import { own, pt } from '@aimuzov/infra-mcp-kit/astro/lib/i18n.ts'

const { service, telegram } = config

if (!telegram) throw new Error('Страница /login/telegram без `telegram` в mcpPages')

const locale = localeOfPath(Astro.url.pathname)

// Виджет нужен только здесь, поэтому и источники Telegram пускаем только на этой странице.
Astro.csp?.insertScriptResource('https://telegram.org')
Astro.csp?.insertDirective('frame-src https://oauth.telegram.org')
---

<Layout title={pt(locale, 'login.title', { service: service.name })} screen="consent">
	<TelegramLogin
		client:load
		service={service.name}
		botName={telegram.botName}
		grants={(telegram.grants ?? []).map((grant, i) => own(locale, `telegram.grant.${i}`, grant))}
		{locale}
	/>
</Layout>
