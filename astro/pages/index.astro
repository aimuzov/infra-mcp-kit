---
import Card from '@aimuzov/infra-site-kit/ui/card.svelte'
import { icons } from '@lucide/svelte'
import config from 'virtual:infra-mcp-kit/pages'

import Connect from '@aimuzov/infra-mcp-kit/astro/components/connect.svelte'
import Layout from '@aimuzov/infra-mcp-kit/astro/layout.astro'

const { service } = config

// Иконки рисуются на сборке, в браузер уходит только SVG. Опечатка в имени роняет сборку.
const pascal = (name: string) => name.replace(/(^|-)([a-z0-9])/g, (_, __, c: string) => c.toUpperCase())
const tools = (service.tools ?? []).map((tool) => {
	if (typeof tool === 'string') return { label: tool, Icon: undefined }

	const Icon = tool.icon ? (icons as Record<string, typeof icons.Kanban>)[pascal(tool.icon)] : undefined

	if (tool.icon && !Icon) throw new Error(`Нет иконки Lucide «${tool.icon}» у инструмента «${tool.label}»`)

	return { label: tool.label, Icon }
})
---

<Layout title={service.name} screen="landing">
	<section class="hero">
		<div class="hero__title">
			{service.logoSvg && <span class="hero__logo" set:html={service.logoSvg} />}
			<h1 class="glitch" data-text={service.name}>
				{service.name}
			</h1>
		</div>
		{service.tagline && <p class="tagline">{service.tagline}</p>}
		{service.lead && <p class="lead">{service.lead}</p>}
	</section>
	<Connect client:load name={service.name} />
	{service.tools && service.tools.length > 0 && (
		<Card>
			<h2 class="section-title">Инструменты</h2>
			<ul class="chips">
				{tools.map(({ label, Icon }) => (
					<li>
						{Icon && <Icon class="chips__icon" size={15} />}
						<code>{label}</code>
					</li>
				))}
			</ul>
		</Card>
	)}
</Layout>
