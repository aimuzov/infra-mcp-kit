---
import config from 'virtual:infra-mcp-kit/pages'

import Layout from '@aimuzov/infra-mcp-kit/astro/layout.astro'

const { service, telegram } = config

// Виджет нужен только здесь, поэтому и источники Telegram пускаем только на этой странице.
Astro.csp?.insertScriptResource('https://telegram.org')
Astro.csp?.insertDirective('frame-src https://oauth.telegram.org')
---

<Layout title={`Вход в ${service.name}`} screen="consent">
	<section class="panel auth">
		<h1>Вход в {service.name}</h1>
		<p class="muted">Войди через Telegram.</p>
		<div data-telegram data-bot={telegram!.botName}></div>
	</section>
	<script>
		// data-auth-url собирается из фрагмента: виджет вернёт человека GET-ом на колбэк с запросом.
		const host = document.querySelector<HTMLElement>('[data-telegram]')!
		const hash = new URLSearchParams(location.hash.slice(1))
		const request = hash.get('request') ?? ''
		const callback = new URL(hash.get('callback') ?? '', location.origin)

		callback.searchParams.set('request', request)

		const widget = document.createElement('script')

		widget.async = true
		widget.src = 'https://telegram.org/js/telegram-widget.js?22'
		widget.dataset.telegramLogin = host.dataset.bot
		widget.dataset.size = 'large'
		widget.dataset.authUrl = callback.href
		host.append(widget)
	</script>
</Layout>
