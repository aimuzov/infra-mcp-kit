---
import { localeOfPath } from '@aimuzov/infra-site-kit/i18n.js'
import config from 'virtual:infra-mcp-kit/pages'

import TelegramSignin from '@aimuzov/infra-mcp-kit/astro/components/telegram-signin.svelte'
import Layout from '@aimuzov/infra-mcp-kit/astro/layout.astro'
import { pt } from '@aimuzov/infra-mcp-kit/astro/lib/i18n.ts'

const locale = localeOfPath(Astro.url.pathname)

// Виджет нужен только на страницах входа, поэтому и источники Telegram пускаем только здесь.
Astro.csp?.insertScriptResource('https://telegram.org')
Astro.csp?.insertDirective('frame-src https://oauth.telegram.org')
---

<Layout title={pt(locale, 'account.signinPage', { service: config.service.name })} screen="consent">
	<TelegramSignin client:load {locale} />
</Layout>
